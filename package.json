{
  "name": "kt.js-monorepo",
  "version": "0.40.19",
  "private": true,
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "purpose": "npm",
  "description": "A simple and easy-to-use web framework, never re-render. Abbreviation of Kasukabe Tsumugi.",
  "description_zh": "KT.js，简单易用的web框架！给自己一个极致优化的机会！取自Kasukabe Tsumugi的首字母。",
  "type": "module",
  "homepage": "https://github.com/baendlorel/kt.js#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/baendlorel/kt.js"
  },
  "keywords": [
    "framework",
    "web",
    "typescript",
    "javascript",
    "monorepo"
  ],
  "scripts": {
    "exp": "pnpm --filter @ktjs/example dev",
    "repolist": "tsx ./scripts/repo-list.ts",
    "lines": "tsx ./scripts/lines.ts",
    "check": "tsx ./scripts/index.ts --check",
    "rollupbuild": "tsx ./scripts/index.ts --rollup-build",
    "build": "tsx ./scripts/index.ts --vite-build",
    "sync-readme": "tsx ./scripts/index.ts --readme",
    "pub": "tsx ./scripts/index.ts --publish",
    "test": "tsx ./scripts/index.ts --test",
    "cover": "pnpm -r --if-present run cover",
    "lint": "oxlint .",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "@ktjs/ts-plugin": "^0.3.7",
    "@ktjs/vite-plugin-ktjsx": "^0.5.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.2.3",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "magic-string": "^0.30.21",
    "oxlint": "^1.47.0",
    "prettier": "^3.8.1",
    "rollup": "^4.60.2",
    "rollup-plugin-conditional-compilation": "^2.1.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-func-macro": "^1.2.2",
    "rollup-plugin-hide-private": "^0.4.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.9",
    "vite-plugin-babel": "^1.6.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint .",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "marked": "^18.0.2",
    "shiki": "^4.0.2",
    "type-narrow": "^0.2.2"
  }
}
