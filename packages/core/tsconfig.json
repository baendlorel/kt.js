{
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "rootDir": "..", // This is for "../shared/src/**/*"
    "paths": {
      "@ktjs/core": ["./src/index.ts"],
      "@ktjs/core/jsx": ["./src/index.ts"],
      "@ktjs/core/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@ktjs/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["./src/**/*", "../shared/src/**/*"]
}
