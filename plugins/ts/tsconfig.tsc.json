{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // ! rootDir and outDir Must be like this if we use `tsc`
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": ["./src/**/*.ts"]
}
